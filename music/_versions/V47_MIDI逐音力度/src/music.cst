//=============================================================================
// ★★ V41 新增：LED 演奏指引的第二路 I2C ★★
//
//   ★★ 本次只【追加】下面这两组，上面一行都没改 ★★
//
//   V17 / W17 在本文件里没有被任何别的端口占用（是空脚），
//   而且已经【实测确认】：独立工程 D:\...\Documents\60k\LEDs 就是用
//   这两个脚把 36 颗灯点亮的。
//
//   ★ 注意和 ADS1115 那条 I2C 区分开（那是 i2c_scl=G22 / i2c_sda=V19）：
//       ADS1115（摇杆）: i2c_scl / i2c_sda
//       LED 指引        : led_scl / led_sda   ← 本节这两根
//
//   ★ PULL_MODE=UP：I2C 是开漏总线，这两个脚必须有上拉才有高电平。
//     板上有外部 4.7k 上拉（独立工程已验证），这里写 UP 只是兜底。
//=============================================================================
IO_LOC "led_scl" V17;
IO_PORT "led_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_sda" W17;
IO_PORT "led_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

//=============================================================================
// ★★ V44 新增：延迟测量测试脚（外部示波器）★★
//
//   ★★ 本次只【追加】下面两组，上面一行都没改 ★★
//
//   C19 -> lat_key ：琴键端（示波器 CH1）—— FPGA 检测到"有键刚按下"那一拍
//   C18 -> lat_pcm ：PCM 端（示波器 CH2）—— 样本由 0 变非 0 那一拍
//   第三通道直接夹喇叭/DAC 模拟输出，不用加脚。
//
//   C18 / C19 在本文件里原本没有被任何端口占用（是空脚）。
//
//   DRIVE=8：这两个脚只驱动示波器高阻探头，8mA 足够。
//   PULL_MODE=NONE：它们是【输出】，不需要上下拉（下拉反而让空闲电平不明确）。
//=============================================================================
IO_LOC "lat_key" C19;
IO_PORT "lat_key" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "lat_pcm" C18;
IO_PORT "lat_pcm" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;