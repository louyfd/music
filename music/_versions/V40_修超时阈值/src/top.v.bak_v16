        gain_lut[9'd393] = 10'd21;
        gain_lut[9'd394] = 10'd21;
        gain_lut[9'd395] = 10'd21;
        gain_lut[9'd396] = 10'd21;
        gain_lut[9'd397] = 10'd21;
        gain_lut[9'd398] = 10'd20;
        gain_lut[9'd399] = 10'd20;
        gain_lut[9'd400] = 10'd20;
        gain_lut[9'd401] = 10'd20;
